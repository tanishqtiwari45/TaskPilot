# TaskPilot Environment Configuration Template
# 
# LOCAL DEVELOPMENT: Copy this file to .env and fill in the values below
# CI/CD DEPLOYMENT: Secrets are managed via Jenkins Credentials (see below)
#
# DO NOT commit .env files to Git - they are ignored by .gitignore

FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=super-secret-key-change-in-production
JWT_SECRET_KEY=jwt-secret-key-change-in-production
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=task_pilot_db

# ========================================
# Jenkins Credentials Configuration
# ========================================
# 
# When deployed via Jenkins CI/CD, the following credentials are
# automatically injected and used instead of hardcoded values:
#
# UAT Environment:
#   - taskpilot-uat-db (Username/Password)
#   - taskpilot-uat-secret-key (Secret text)
#
# PROD Environment:
#   - taskpilot-prod-db (Username/Password)
#   - taskpilot-prod-secret-key (Secret text)
#
# These credentials are defined in Jenkins and injected via withCredentials() blocks.
# For local development, manually set the values above in .env file.
